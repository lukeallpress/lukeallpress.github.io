---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, SOCIAL } from '../consts';
import { ABOUT, SPEAKING, COMMITTEES, SKILLS } from '../data/profile';
import { GUIDANCE } from '../data/guidance';

// Selected work — featured, non-draft, sorted by `order`
const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Latest writing — newest first, top 3
const writing = (await getCollection('writing'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<Base path="/">
  <!-- ——— Hero ——————————————————————————————————— -->
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{SITE.role}</p>
      <h1>Making complicated things simple.</h1>
      <p class="lede prose">
        I'm Luke Allpress — an education technology and AI leader in {SITE.location}.
        I help schools turn fast-moving technology into tools people can actually use:
        district-owned software, practical AI guidance, and learning communities where
        educators build with confidence.
      </p>
      <div class="cta">
        <a class="btn" href="#work">See selected work</a>
        <a class="btn btn-ghost" href="/cv">Read the CV</a>
      </div>
      <ul class="hero-links">
        {SOCIAL.map((s) => (
          <li><a href={s.href}>{s.label} <span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ——— About ——————————————————————————————————— -->
  <section class="section" id="about">
    <div class="wrap about-grid">
      <p class="eyebrow">About</p>
      <div class="about-body prose">
        {ABOUT.split('\n\n').map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <!-- ——— Selected Work ——————————————————————————— -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected Work</p>
          <h2>Things I've built</h2>
        </div>
      </div>
      <div class="work-grid">
        {projects.map((p) => (
          <article class="card">
            <div class="card-top">
              {p.data.kind && <span class="chip">{p.data.kind}</span>}
              {p.data.year && <span class="card-year">{p.data.year}</span>}
            </div>
            <h3><a href={`/projects/${p.id}`}>{p.data.title}</a></h3>
            <p class="card-summary">{p.data.summary}</p>
            <div class="card-foot">
              <a class="link-arrow" href={`/projects/${p.id}`}>Details</a>
              {p.data.demo && <a class="link-arrow" href={p.data.demo}>Live demo</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ——— Toolkit ————————————————————————————————— -->
  <section class="section" id="toolkit">
    <div class="wrap toolkit-grid">
      <div class="toolkit-intro">
        <p class="eyebrow">Toolkit</p>
        <h2>How I build</h2>
        <p class="toolkit-note">
          I use technical tools pragmatically — not to show off complexity, but to make
          school-system work clearer, faster, and more reliable.
        </p>
      </div>
      <div class="toolkit-cols">
        {SKILLS.map((g) => (
          <div class="toolkit-col">
            <h3>{g.label}</h3>
            <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ——— Writing ————————————————————————————————— -->
  <section class="section" id="writing">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Writing</p>
          <h2>Notes & reflections</h2>
        </div>
        <a class="more link-arrow" href="/writing">All writing</a>
      </div>
      <ul class="writing-list">
        {writing.map((w) => (
          <li>
            <a class="writing-row" href={`/writing/${w.id}`}>
              <time datetime={w.data.date.toISOString()}>{fmt(w.data.date)}</time>
              <div>
                <h3>{w.data.title}</h3>
                <p>{w.data.summary}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ——— Guidance & Resources ————————————————————— -->
  <section class="section" id="guidance">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Guidance & Resources</p>
          <h2>Documents I help shape</h2>
        </div>
      </div>
      <ul class="guidance-list">
        {GUIDANCE.map((g) => (
          <li class="guidance-row">
            <div class="guidance-main">
              <h3>
                {g.href ? <a href={g.href}>{g.title}</a> : g.title}
              </h3>
              <p class="guidance-meta">{g.org} · {g.year}{g.status ? ` · ${g.status}` : ''}</p>
              <p class="guidance-desc">{g.description}</p>
            </div>
            <div class="guidance-action">
              {g.href
                ? <a class="link-arrow" href={g.href}>Open</a>
                : <span class="muted-note">Available on request</span>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ——— Speaking & Community ————————————————————— -->
  <section class="section" id="speaking">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Speaking</p>
        <h2 class="col-title">Talks & sessions</h2>
        <ul class="stack-list">
          {SPEAKING.map((s) => (
            <li>
              <div class="stack-head">
                <h3>{s.title}</h3>
                <span class="chip">{s.kind}</span>
              </div>
              <p class="stack-meta">{s.venue} · {s.year}</p>
              {s.note && <p class="stack-note">{s.note}</p>}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Community</p>
        <h2 class="col-title">Boards & committees</h2>
        <ul class="stack-list">
          {COMMITTEES.map((c) => (
            <li>
              <h3>{c.org}</h3>
              <p class="stack-meta">{c.role}</p>
              {c.detail && <p class="stack-note">{c.detail}</p>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ——— Contact ————————————————————————————————— -->
  <section class="section contact">
    <div class="wrap prose">
      <p class="eyebrow">Get in touch</p>
      <h2>Let's build something useful.</h2>
      <p class="contact-lede">
        Whether it's AI guidance, district-owned tools, or starting a learning group —
        I'm always happy to compare notes.
      </p>
      <a class="btn" href={`mailto:${SITE.email}`}>Email me</a>
    </div>
  </section>
</Base>

<style>
  /* —— Hero —— */
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero h1 {
    margin-top: 0.6rem;
    max-width: 16ch;
  }
  .lede {
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .cta {
    margin-top: 2rem;
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .hero-links {
    margin-top: 2rem;
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .hero-links a {
    font-size: 0.95rem;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }
  .hero-links a:hover { color: var(--accent-deep); border-color: var(--accent); }

  /* —— About —— */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
  }
  .about-body { font-size: var(--step-1); line-height: 1.6; color: var(--ink); }
  .about-body p + p { margin-top: 1.2em; }
  @media (max-width: 46rem) {
    .about-grid { grid-template-columns: 1fr; }
    .about-body { font-size: var(--step-0); }
  }

  /* —— Work grid —— */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
    border-color: var(--line);
  }
  .card-top { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .card-year { font-size: var(--step--1); color: var(--ink-3); }
  .card h3 { font-size: var(--step-1); }
  .card h3 a { text-decoration: none; }
  .card h3 a:hover { color: var(--accent-deep); }
  .card-summary { color: var(--ink-2); font-size: 0.98rem; flex: 1; }
  .card-foot { display: flex; gap: 1.25rem; padding-top: 0.25rem; }

  /* —— Writing list —— */
  .writing-list { list-style: none; padding: 0; margin: 0; }
  .writing-list li + li { border-top: 1px solid var(--line-soft); }
  .writing-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    padding-block: 1.5rem;
    text-decoration: none;
    align-items: baseline;
  }
  .writing-row time { color: var(--ink-3); font-size: 0.9rem; padding-top: 0.4rem; }
  .writing-row h3 { font-size: var(--step-1); transition: color 0.18s ease; }
  .writing-row:hover h3 { color: var(--accent-deep); }
  .writing-row p { color: var(--ink-2); margin-top: 0.35rem; font-size: 0.98rem; }
  @media (max-width: 38rem) {
    .writing-row { grid-template-columns: 1fr; gap: 0.4rem; }
    .writing-row time { padding-top: 0; }
  }

  /* —— Guidance —— */
  .guidance-list { list-style: none; padding: 0; margin: 0; }
  .guidance-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }
  .guidance-row + .guidance-row { border-top: 1px solid var(--line-soft); }
  .guidance-main h3 { font-size: var(--step-1); }
  .guidance-meta { color: var(--accent-deep); font-size: 0.85rem; margin-top: 0.3rem; letter-spacing: 0.01em; }
  .guidance-desc { color: var(--ink-2); margin-top: 0.5rem; max-width: 60ch; font-size: 0.98rem; }
  .guidance-action { white-space: nowrap; padding-top: 0.3rem; }
  .muted-note { color: var(--ink-3); font-size: 0.9rem; font-style: italic; }
  @media (max-width: 38rem) {
    .guidance-row { flex-direction: column; gap: 0.6rem; }
  }

  /* —— Toolkit —— */
  .toolkit-grid {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }
  .toolkit-intro h2 { font-size: var(--step-2); margin-top: 0.4rem; }
  .toolkit-note { color: var(--ink-2); margin-top: 1rem; font-size: 0.98rem; }
  .toolkit-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1.5rem 2rem;
  }
  .toolkit-col h3 {
    font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.12em;
    font-family: var(--sans); font-weight: 600; color: var(--accent-deep);
    padding-bottom: 0.6rem; margin-bottom: 0.8rem; border-bottom: 1px solid var(--line);
  }
  .toolkit-col ul { list-style: none; padding: 0; margin: 0; }
  .toolkit-col li { color: var(--ink-2); font-size: 0.95rem; padding-block: 0.22rem; }
  @media (max-width: 46rem) {
    .toolkit-grid { grid-template-columns: 1fr; }
  }

  /* —— Two-column speaking/community —— */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 4.5rem);
  }
  .col-title { font-size: var(--step-2); margin-top: 0.5rem; margin-bottom: 1.75rem; }
  .stack-list { list-style: none; padding: 0; margin: 0; }
  .stack-list li { padding-block: 1.1rem; }
  .stack-list li + li { border-top: 1px solid var(--line-soft); }
  .stack-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; }
  .stack-list h3 { font-size: var(--step-0); font-weight: 500; font-family: var(--sans); letter-spacing: -0.005em; }
  .stack-meta { color: var(--accent-deep); font-size: 0.85rem; margin-top: 0.25rem; }
  .stack-note { color: var(--ink-2); font-size: 0.93rem; margin-top: 0.4rem; }
  @media (max-width: 46rem) {
    .two-col { grid-template-columns: 1fr; }
  }

  /* —— Contact —— */
  .contact { text-align: left; }
  .contact h2 { font-size: var(--step-3); margin-top: 0.5rem; }
  .contact-lede { color: var(--ink-2); font-size: var(--step-1); margin-top: 1rem; margin-bottom: 1.75rem; }
</style>
