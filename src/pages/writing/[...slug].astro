---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((w) => !w.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.summary} path={`/writing/${post.id}`}>
  <article class="section">
    <div class="wrap">
      <a class="back link-arrow-back" href="/writing">← All writing</a>

      <header class="essay-head prose">
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.origin && <><span aria-hidden="true">·</span> <span>{post.data.origin}</span></>}
        </div>
        <h1>{post.data.title}</h1>
        <p class="standfirst">{post.data.summary}</p>
      </header>

      <div class="essay prose">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <div class="tags prose">
          {post.data.tags.map((t) => <span class="chip">{t}</span>)}
        </div>
      )}

      <a class="back link-arrow-back" href="/writing">← All writing</a>
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--ink-2);
    text-decoration: none;
    margin-bottom: 2.5rem;
  }
  .back:last-child { margin-top: 3rem; margin-bottom: 0; }
  .back:hover { color: var(--accent-deep); }

  .essay-head { margin-bottom: 2.5rem; }
  .meta {
    display: flex; gap: 0.5rem; align-items: center;
    color: var(--ink-3); font-size: 0.85rem; letter-spacing: 0.02em;
  }
  .essay-head h1 { font-size: var(--step-3); margin-top: 0.75rem; }
  .standfirst {
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
    font-family: var(--serif);
    font-style: italic;
  }
  .tags {
    display: flex; gap: 0.5rem; flex-wrap: wrap;
    margin-top: 2.5rem; padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }
</style>
